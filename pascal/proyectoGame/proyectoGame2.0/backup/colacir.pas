
   Unit COLACIR;
interface
CONST N= 4;
TYPE
T_DATO= RECORD
NOM: STRING[40];
TEL: STRING[15];
END;
T_COLA= RECORD
FRENTE,FINAL: word;
ELEM:ARRAY [1..N] OF T_DATO;
TAM: WORD;
END;
PROCEDURE CREARCOLA(VAR Q:T_COLA);
PROCEDURE ENCOLAR (VAR Q:T_COLA; X:T_DATO);
FUNCTION COLA_LLENA (VAR Q:T_COLA): BOOLEAN;
FUNCTION COLA_VACIA (VAR Q:T_COLA): BOOLEAN;
PROCEDURE DESENCOLAR (VAR Q:T_COLA; VAR X:T_DATO);
implementation
PROCEDURE CREARCOLA(VAR Q:T_COLA);

BEGIN
Q.TAM:=0;
Q.FRENTE:=1;
Q.FINAL:= N;
END;
PROCEDURE ENCOLAR (VAR Q:T_COLA; X:T_DATO);
BEGIN
IF Q.FINAL = N THEN Q.FINAL:= 1
ELSE Q.FINAL:= Q.FINAL + 1;
Q.ELEM[Q.FINAL]:= X;
INC(Q.TAM);
END;
FUNCTION COLA_LLENA (VAR Q:T_COLA): BOOLEAN;

