BEGIN
COLA_LLENA:= Q.TAM = N ;
END;
FUNCTION COLA_VACIA (VAR Q:T_COLA): BOOLEAN;
BEGIN
COLA_VACIA:= Q.TAM = 0;
END;
PROCEDURE DESENCOLAR (VAR Q:T_COLA;VAR X:T_DATO);
BEGIN
X:= Q.ELEM[Q.FRENTE];
IF Q.FRENTE= N THEN Q.FRENTE := 1
ELSE Q.FRENTE:= Q.FRENTE +1;
DEC(Q.TAM)
END;
END.
end.

